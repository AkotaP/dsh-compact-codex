{
  "name": "dsh-compact-codex",
  "version": "1.2.0",
  "description": "可拆卸的 Codex 风格交接压缩：保留 DSH 默认触发策略与 /compact，不覆盖预设。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkotaP/dsh-compact-codex.git"
  },
  "homepage": "https://github.com/AkotaP/dsh-compact-codex",
  "bugs": {
    "url": "https://github.com/AkotaP/dsh-compact-codex/issues"
  },
  "private": true,
  "type": "module",
  "main": "./lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js",
    "./engine": "./lib/index.js",
    "./preset": "./lib/preset.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "test": "node --import ./test/support/register-runtime.mjs --test --test-isolation=none test/*.test.mjs",
    "install:profile": "node ./scripts/profile.mjs install",
    "uninstall:profile": "node ./scripts/profile.mjs uninstall"
  },
  "engines": { "node": ">=22.15.0", "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-util-values": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-scope": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-compaction-basic": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-util-values": { "optional": true },
    "@deepseek-ai/dsh-scope": { "optional": true }
  },
  "license": "MIT"
}
